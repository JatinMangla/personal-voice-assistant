<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the phone's built-in certificate authorities (never user-added
     ones, so an installed "trusted" certificate can't read the traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
